<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="turtle_warehouse_world">

    <!-- 물리 엔진 설정 -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- 조명 -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 실내 형광등 효과 -->
    <light name="light_center" type="point">
      <pose>0 0 4 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
      </attenuation>
    </light>
    <light name="light_nw" type="point">
      <pose>-6 6 4 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <attenuation>
        <range>15</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
      </attenuation>
    </light>
    <light name="light_ne" type="point">
      <pose>6 6 4 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <attenuation>
        <range>15</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
      </attenuation>
    </light>
    <light name="light_se" type="point">
      <pose>6 -6 4 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <attenuation>
        <range>15</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
      </attenuation>
    </light>

    <!-- 바닥 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- 외벽 (Outer Walls)  20m x 20m 창고                           -->
    <!-- ============================================================ -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 10 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry>
            <box>
              <size>20.4 0.3 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box>
              <size>20.4 0.3 2.5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
